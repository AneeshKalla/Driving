    "# Run the entire frames_df through DINO in one batch\n",
    "all_frame_paths = frames_df['frame_path'].tolist()\n",
    "images = []\n",
    "for path in all_frame_paths:\n",
    "    img = Image.open(path).convert('RGB')\n",
    "    img_t = normalize_image(resize_transform(img))\n",
    "    images.append(img_t)\n",
    "\n",
    "img_batch = torch.stack(images, dim=0)\n",
    "print(f'Batch shape: {img_batch.shape}')\n",
    "\n",
    "batch_tokens = dino_forward_tokens(model, img_batch, layers=[N_LAYERS - 1])\n",
    "layer_idx = list(batch_tokens.keys())[0]\n",
    "cls_tokens = batch_tokens[layer_idx]['cls']\n",
    "patch_tokens = batch_tokens[layer_idx]['patch']\n",
    "print(f'CLS tokens shape: {cls_tokens.shape}')\n",
    "print(f'Patch tokens shape: {patch_tokens.shape}')\n",
    "\n",
    "# Example: attach tokens back to frames_df\n",
    "frames_df['cls_token'] = list(cls_tokens.numpy())\n",
    "frames_df['patch_tokens'] = list(patch_tokens.numpy())\n",
    "frames_df.head()\n"
   ]
