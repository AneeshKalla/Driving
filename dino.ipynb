    "    entry[\"misfire_clips\"] = len(entry[\"misfire_clips\"])\n",
    "    results.append(entry)\n",
    "\n",
    "threshold_results_df = pd.DataFrame(results).sort_values(\"threshold\")\n",
    "threshold_results_df"
